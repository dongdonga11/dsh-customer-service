{
  "manifest_version": 3,
  "name": "DSH 闲鱼客服",
  "version": "0.2.0",
  "description": "寄生在已登录的 goofish.com 页面，监听闲鱼买家消息并执行 DSH 客服中心下发的动作。所有请求由真人页面发出，抗风控。",
  "permissions": ["storage", "scripting", "activeTab", "alarms", "tabs"],
  "host_permissions": [
    "*://*.goofish.com/*",
    "*://*.taobao.com/*",
    "*://*.alicdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DSH 闲鱼客服"
  },
  "content_scripts": [
    {
      "matches": ["*://*.goofish.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.goofish.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://*.goofish.com/*"]
    }
  ]
}
